# Copy to .env and fill in. All values are optional; defaults shown.
# The scan ALWAYS runs headful (real Chrome window) — COMC's Cloudflare only clears that way.

# --- Business rules (spec 2026-09-02) ---
MIN_DISCOUNT_PERCENT=20          # INTEGER percent: COMC price must be >= 20% below the reference
MIN_COMC_PRICE=10                # min COMC ask in USD (R$50 "valuable card" floor); 0 disables
MAX_COMC_PRICE=0                 # per-card budget ceiling in USD (cuts BEFORE the PriceCharting lookup); 0 = none
MAX_ENGLISH_PER_SET=0            # stop a set/pass after N valid ENGLISH listings (JP/KR do not count); 0 = all pages
ICONIC_ONLY=true                 # only Pokémon from comc_scanner/iconic_pokemon.csv (--all-pokemon = false)
SCAN_RAW=true                    # raw NM singles pass
SCAN_SLABS=true                  # graded (slab) pass
GRADED_ALLOW=PSA 8,PSA 9,PSA 10,CGC 9,CGC 9.5,CGC 10 GEM,CGC 10 PRISTINE,BGS 9,BGS 9.5,BGS 10,BGS 10 BLACK,SGC 9,SGC 9.5,SGC 10,TAG 9.5,TAG 10   # slabs aceitos; referência = mediana de vendas da MESMA certificadora+nota
CHASE_ONLY=false                 # true = keep only chase rarities
CHASE_EXCLUDE_RARITIES=common,uncommon,rare
TOP_N=200                        # number of deals to keep/report
MIN_MATCH_CONFIDENCE=0.80        # below -> low-confidence bucket
TRUST_CONFIDENCE=0.90            # below -> MATCH_REVIEW
SET_ALLOWLIST=                   # optional CSV of set names (normally use --group)

# --- COMC browse ---
COMC_CONDITION_ALLOW=nm          # raw pass, MODERN sets (recent/middle): exact NM only
COMC_CONDITION_ALLOW_VINTAGE=nm,ex-nm   # raw pass, VINTAGE (WotC): COMC grades most raw WotC as EX-NM
LP_WITH_REFERENCE=true   # raw LP só com ≥3 vendas 'LP'/'Lightly Played' (PriceCharting); nunca LP vs NM
COMC_CONDITION_BAND=EX-NM        # COMC g-facet for the raw pass (ignored on set-path browse)
COMC_SELLER_REPO=                # "" = all seller repos (default)
COMC_SORT=sh                     # sh = highest price first; sl = lowest first
COMC_REQUEST_DELAY_SECONDS=4     # polite delay between COMC page loads (jittered)
COMC_PROFILE_DIR=                # persistent Chrome profile (default .cache/pw_profile_comc)
COMC_SESSION_COOKIE=             # optional logged-in COMC cookie string
COMC_EXCLUDE_VARIANTS=japanese,korean,german,spanish,french,italian,chinese,portuguese,thai,indonesian

# --- Eras / budget ---
DEFAULT_ERA=all
ERA_VINTAGE_MAX_YEAR=2003   # WotC (Base…Skyridge) = NM/EX-NM; 2004+ = NM só (operador 2026-09-02)
ERA_MIDDLE_MAX_YEAR=2019
MAX_RUN_SECONDS=0
MAX_PAGES_PER_SET=0
SCAN_INTERVAL_SECONDS=3600       # partial flush cadence

# --- Reference prices (today-only caches) ---
TCGCSV_FORCE_REFRESH=true        # always download today's TCGplayer snapshot
TCGDEX_FALLBACK=true             # TCGdex fallback when tcgcsv fails for a set
PC_CACHE_DIR=                    # PriceCharting cache root (default .cache/pc/<YYYY-MM-DD>)
HTTP_USER_AGENT=comc-scanner/0.3 (+https://github.com/matheuscllm-lgtm/scanner-comc)
