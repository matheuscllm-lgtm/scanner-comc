# Copy to .env and fill in. All values are optional unless noted; defaults shown.

# --- COMC fetch transport ---
# "firecrawl" (default): headless, no local browser/login — clears Cloudflare via
#   Firecrawl's stealth proxy. Needs FIRECRAWL_API_KEY (below).
# "playwright": local browser, CREDIT-FREE. Uses patchright + real Chrome HEADFUL to
#   auto-solve COMC's Cloudflare Turnstile (no human). Forced headful; needs Chrome
#   installed + a display (or virtual display on a server). NOT for GitHub Actions.
#   Run: python -m comc_scanner targeted --era recent --fetch-mode playwright
COMC_FETCH_MODE=firecrawl
FIRECRAWL_API_KEY=               # required for firecrawl mode (fc-...); inherited from env if set
FIRECRAWL_WAIT_MS=12000          # render wait before grabbing HTML (COMC CF needs ~12s)
FIRECRAWL_PROXY=stealth          # stealth | auto | enhanced | basic
COMC_PROFILE_DIR=               # playwright persistent profile (default .cache/pw_profile_comc);
                                 # warm once with `comc_scanner warm` to cache cf_clearance

# --- COMC scraping (playwright mode) ---
# Authenticated session cookie string from your logged-in COMC account, e.g.
# "ASP.NET_SessionId=xxx; cf_clearance=yyy; .COMCAUTH=zzz". Helps pass Cloudflare
# and unlocks consistent pricing. Leave blank to browse anonymously.
COMC_SESSION_COOKIE=
COMC_CONDITION_BAND=EX-NM        # COMC condition facet (g-token): EX-NM, LP, etc.
COMC_INCLUDE_GRADED=false        # false -> aUngraded (excludes PSA/BGS/CGC/SGC)
COMC_SELLER_REPO=                # "" = all seller repos (default). "COMC" = RCR-only,
                                 # which is EMPTY for vintage WotC ungraded — leave blank.
COMC_SORT=sh                     # sh = highest price first (surfaces valuable NM cards +
                                 # big-$ arbitrage early); sl = lowest first.
COMC_CONDITION_ALLOW=nm,mint,m,ex-nm,exnm,near mint  # NM-only invariant: kept conditions
                                 # (g-band facet is ignored on set-path browse). Tighten to
                                 # "nm,mint,m" for strict NM (drops EX-NM).
COMC_REQUEST_DELAY_SECONDS=4     # polite delay between COMC page loads (jittered)
COMC_BROWSER_HEADLESS=true       # set false to watch the browser solve Cloudflare

# --- Scan behaviour ---
MIN_GROSS_MARGIN=0.20            # 0.20 = 20% gross margin threshold
TOP_N=50                         # number of deals to keep/report
SCAN_INTERVAL_SECONDS=3600       # how often partial results are flushed (~hourly)
MIN_MATCH_CONFIDENCE=0.80        # min listing<->TCG match confidence for the top list
MARGIN_MODE=gross                # gross | markup
SET_ALLOWLIST=                   # optional CSV of TCG set names/abbrevs to restrict scope

# --- Eras / chunking (so long sweeps don't blow up the time budget) ---
DEFAULT_ERA=all                  # all | recent | middle | vintage
ERA_VINTAGE_MAX_YEAR=2010        # sets published <= this year -> vintage
ERA_MIDDLE_MAX_YEAR=2019         # sets published <= this year (and > vintage) -> middle; later -> recent
MAX_RUN_SECONDS=0                # 0 = unlimited; otherwise stop the chunk after N seconds
MAX_SETS_PER_CHUNK=0             # 0 = unlimited; otherwise process at most N sets per run
MAX_PAGES_PER_SET=0              # 0 = until empty; otherwise cap COMC pages per set

# --- TCGCSV ---
TCGCSV_FORCE_REFRESH=false       # force re-download of the daily price snapshot
HTTP_USER_AGENT=comc-scanner/0.1 (+https://github.com/matheuscllm-lgtm/scanner-comc)

# --- Optional Google Sheets push (absence -> CSV only) ---
GOOGLE_SHEETS_CREDENTIALS_JSON=  # path to a service-account .json OR inline JSON
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_WORKSHEET=COMC Deals
