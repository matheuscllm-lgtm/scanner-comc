# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# Local caches / scraper state / browser profiles (never commit secrets or session cookies)
.cache/
browser_state.json
pw_profile*/
*_profile/
storage_state*.json
cookies*.json

# Run outputs (working data, not source) — keep the directory, ignore its contents
results/*
!results/.gitkeep

# Internal session / working notes (kept locally, not published)
HANDOFF.md
